# Local dev DB: docker compose -f ../docker/docker-compose.yml up -d
DATABASE_URL="postgresql://hppku:hppku@localhost:5432/hppku?schema=public"
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Public URL of this backend (Better Auth builds cookie/redirect origins from it)
BETTER_AUTH_URL="http://localhost:4000"
# Frontend and API on sibling subdomains (app.x.com + api.x.com): share the session cookie. Unset in dev.
# COOKIE_DOMAIN=.x.com
PORT=4000
# Browser origin allowed by CORS (credentials: include)
FRONTEND_ORIGIN="http://localhost:3000"
# Production behind Coolify/Traefik: 1 (so rate limits see the real client IP). Unset in dev.
# TRUST_PROXY_HOPS=1
# Max new accounts per client IP per day (shared NAT/office: raise it). Default 3.
# MAX_SIGNUPS_PER_IP_PER_DAY=3

# Cloudflare Turnstile secret for the register form. Empty = bot check off.
# Dev test secrets: pass 1x0000000000000000000000000000000AA, fail 2x0000000000000000000000000000000AA
# (pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA in the frontend)
TURNSTILE_SECRET_KEY=""

# Queue for async receipt OCR (BullMQ)
REDIS_URL="redis://localhost:6379"
# S3-compatible storage for receipt photos (dev: SeaweedFS from docker-compose)
S3_ENDPOINT="http://localhost:8333"
S3_BUCKET="receipts"
S3_ACCESS_KEY="dev"
S3_SECRET_KEY="dev"
# S3_REGION="us-east-1"
# Postgres pool size per backend instance (default 10). Keep instances x this below the DB max_connections.
# DB_POOL_MAX=10
# AI via OpenRouter. Empty key = AI features return 503, rest of the app works.
OPENROUTER_API_KEY=""
# Must support image input + structured_outputs. Not `openrouter/free` (random model, JSON may fail).
OPENROUTER_MODEL="dots-studio/dots-3-note-preview:free"
# App-wide cap on AI provider calls per day (backstop behind per-plan quotas). 0 = unlimited. Default 1000.
# AI_DAILY_CALL_CAP=1000
# Local dev alternative: set to use Ollama instead of OpenRouter (key not needed).
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="qwen2.5vl:7b"
